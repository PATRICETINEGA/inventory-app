generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  items     Item[]
  createdAt DateTime @default(now())
}

model Item {
  id        String   @id @default(cuid())
  name      String
  quantity  Int      @default(0)
  category  String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
